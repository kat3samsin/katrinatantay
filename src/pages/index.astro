---
import Layout from '../layouts/Layout.astro';
import { getPosts } from '../lib/wordpress';

// Fetch latest posts from WordPress
const posts = await getPosts(3);

// Katrina's experience - clean summaries
const experience = [
  {
    company: "Automattic",
    team: "AI Team",
    role: "Applied AI Engineer",
    period: "2025 - Present",
    logo: "automattic",
    url: "https://automattic.com",
  },
  {
    company: "Automattic",
    team: "WordPress VIP",
    role: "Senior Software Engineer",
    period: "2022 - 2025",
    logo: "automattic",
    url: "https://wpvip.com",
  },
  {
    company: "Oracle",
    role: "Engineering Manager",
    period: "2019 - 2022",
    logo: "oracle",
    url: "https://oracle.com",
  },
  {
    company: "Oracle",
    role: "Principal Software Engineer",
    period: "2012 - 2019",
    logo: "oracle",
    url: "https://oracle.com",
  },
];

const projects = [
  {
    name: "SkimpyClaw",
    url: "https://skimpyclaw.xyz",
    cta: "Visit site",
    summary: "A local AI assistant for Telegram and Discord, scheduled routines, coding agents, tools, and a small web dashboard.",
    tags: ["AI assistant", "Agents", "Cron", "Dashboard"],
  },
  {
    name: "SimpleShelf",
    url: "https://github.com/kat3samsin/simpleshelf",
    cta: "View on GitHub",
    summary: "A zero-dependency 3D bookshelf component for reading lists, Open Library covers, progress, and hover previews.",
    tags: ["TypeScript", "Books", "Component", "Open Library"],
  },
];

const skillTags = [
  "TypeScript",
  "React",
  "Next.js",
  "WordPress",
  "MCP",
  "AI agents",
  "Image generation",
  "Node.js",
  "GraphQL",
  "Jest",
  "Accessibility",
  "Kubernetes",
];

const githubProfileUrl = "https://github.com/kat3samsin";
const githubContributionYear = new Date().getUTCFullYear();
const githubContributionFrom = `${githubContributionYear}-01-01`;
const githubContributionTo = `${githubContributionYear}-12-31`;
const githubContributionsUrl = `https://github.com/users/kat3samsin/contributions?from=${githubContributionFrom}&to=${githubContributionTo}`;
const githubProfileYearUrl = `${githubProfileUrl}?tab=overview&from=${githubContributionFrom}&to=${githubContributionTo}`;
const githubContributionDocsUrl = "https://docs.github.com/en/account-and-profile/reference/profile-contributions-reference";
const githubLegendLevels = [0, 1, 2, 3, 4];

type GithubContribution = {
  date: string;
  label: string;
  level: number;
  column: number;
  row: number;
  url: string;
};

type GithubMonthLabel = {
  label: string;
  column: number;
};

const githubMonthLabels = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const getHtmlAttribute = (node: string, attribute: string) =>
  node.match(new RegExp(`${attribute}="([^"]+)"`))?.[1] ?? "";
const decodeHtml = (value: string) =>
  value
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/\s+/g, " ")
    .trim();
const getGithubWeekColumn = (date: Date) => {
  const firstDayOfYear = Date.UTC(githubContributionYear, 0, 1);
  const firstSunday = firstDayOfYear - new Date(firstDayOfYear).getUTCDay() * 24 * 60 * 60 * 1000;

  return Math.floor((date.getTime() - firstSunday) / (7 * 24 * 60 * 60 * 1000)) + 1;
};

const githubContributionHtml = await fetch(githubContributionsUrl)
  .then((response) => (response.ok ? response.text() : ""))
  .catch(() => "");
const githubContributionTotal = decodeHtml(githubContributionHtml)
  .match(new RegExp(`([\\d,]+) contributions in ${githubContributionYear}`))?.[1] ?? "";
const githubContributionTitle = githubContributionTotal
  ? `${githubContributionTotal} contributions in ${githubContributionYear}`
  : `GitHub contributions in ${githubContributionYear}`;
const githubDayNodes = Array.from(
  githubContributionHtml.matchAll(/(<td\b[^>]*ContributionCalendar-day[^>]*><\/td>)\s*<tool-tip\b[^>]*>([\s\S]*?)<\/tool-tip>/g)
);
const githubContributions = githubDayNodes
  .map((match): GithubContribution | null => {
    const node = match[1];
    const date = getHtmlAttribute(node, "data-date");
    const level = Number.parseInt(getHtmlAttribute(node, "data-level"), 10);
    const column = Number.parseInt(getHtmlAttribute(node, "data-ix"), 10) + 1;
    const parsedDate = new Date(`${date}T00:00:00.000Z`);

    if (!date || !Number.isFinite(level) || !Number.isFinite(column) || Number.isNaN(parsedDate.getTime())) {
      return null;
    }

    return {
      date,
      label: decodeHtml(match[2]),
      level: Math.min(Math.max(level, 0), 4),
      column,
      row: parsedDate.getUTCDay() + 1,
      url: `${githubProfileUrl}?tab=overview&from=${date}&to=${date}`,
    };
  })
  .filter((day): day is GithubContribution => day !== null);
const githubMonthPositions: GithubMonthLabel[] = githubMonthLabels.map((label, index) => ({
  label,
  column: getGithubWeekColumn(new Date(Date.UTC(githubContributionYear, index, 1))),
}));

// Currently Reading - shelf style
const currentlyReading = [
  { title: "Everything Is Tuberculosis", author: "John Green", isbn: "9780525556572", progress: 0, pages: 198, color: "#2F6B4F", gap: 28, tilt: 2 },
  { title: "My Friends", author: "Fredrik Backman", isbn: "9781982112820", progress: 0, pages: 448, color: "#2B6F8A", gap: 32, tilt: -2 },
  { title: "Shift", author: "Hugh Howey", isbn: "9780544839649", progress: 0, pages: 576, color: "#30353B", gap: 34, tilt: 3 },
];

// Helper functions for shelf
const getThickness = (pages: number) => Math.min(60, Math.max(30, Math.floor(pages / 15)));
const getHeight = (pages: number) => Math.min(180, Math.max(140, 120 + Math.floor(pages / 8)));
function muteColor(hex: string): string {
  const num = parseInt(hex.replace('#', ''), 16);
  let r = (num >> 16) & 255;
  let g = (num >> 8) & 255;
  let b = num & 255;
  const gray = (r + g + b) / 3;
  const saturation = 0.5;
  r = Math.round(r * saturation + gray * (1 - saturation));
  g = Math.round(g * saturation + gray * (1 - saturation));
  b = Math.round(b * saturation + gray * (1 - saturation));
  return `#${((r << 16) | (g << 8) | b).toString(16).padStart(6, '0')}`;
}
const getSpineColor = (color: string) => muteColor(color);
function isLightColor(hex: string): boolean {
  const num = parseInt(hex.replace('#', ''), 16);
  const r = (num >> 16) & 255;
  const g = (num >> 8) & 255;
  const b = num & 255;
  const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
  return luminance > 0.5;
}
const getTextColor = (color: string) => isLightColor(color) ? '#1a1a1a' : '#ffffff';
---

<Layout>
  <section class="home-cover" aria-labelledby="intro-title">
    <div class="home-cover__mast">
      <h1 id="intro-title">Katrina Tantay</h1>
      <p class="home-subtitle">
        Engineer. Product thinker. <span>AI whisperer.</span>
      </p>
    </div>
    <div class="home-cover__brief">
      <p>
        I build AI-powered products that hold up in production.
      </p>
      <p>
        At Automattic, I work across chat, image generation, agent systems, MCP tools,
        and the platform infrastructure that supports them. My focus is bridging
        product, engineering, and AI to create experiences that are useful and dependable.
      </p>
      <p>
        I care about quality. The most interesting work starts after the demo:
        understanding model behavior, polishing user experiences, improving accessibility,
        testing, and handling the messy edge cases real users uncover.
      </p>
      <nav class="home-socials" aria-label="Contact and profile links">
        <a href="mailto:hi@katrinatantay.com" aria-label="Email" title="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-.4 4.25-7.06 4.41a1 1 0 0 1-1.08 0L4.4 8.25V6.5L12 11.25l7.6-4.75v1.75Z" />
          </svg>
        </a>
        <a href="https://github.com/kat3samsin" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.3c0 .32.22.69.83.57A12.01 12.01 0 0 0 24 12c0-6.63-5.37-12-12-12Z" />
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/katrinatantay/" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.23 0Z" />
          </svg>
        </a>
      </nav>
    </div>
  </section>

  <section class="profile-ledger" aria-label="Snapshot">
    <div class="snapshot-strip__item">
      <span>Now</span>
      <strong>Automattic AI</strong>
      <p>Applied AI Engineer</p>
    </div>
    <div class="snapshot-strip__item">
      <span>Before</span>
      <strong>WordPress VIP + Oracle</strong>
      <p>Senior IC, manager, platform work</p>
    </div>
    <div class="snapshot-strip__item">
      <span>Stack</span>
      <strong>TypeScript to WordPress</strong>
      <p>React, APIs, tests, accessibility</p>
    </div>
  </section>

  <section id="cv" class="home-section section-grid">
    <div class="section-intro">
      <p class="section-label">CV</p>
      <h2>Experience</h2>
    </div>
    <div class="experience-list">
      {experience.map((job) => (
        <article class="experience-row">
          <a href={job.url} target="_blank" rel="noopener" class="company-logo" aria-label={job.company}>
            {job.logo === "automattic" && (
              <svg viewBox="0 0 64 64" fill="currentColor" class="w-5 h-5">
                <path d="M53.62 31.294c0-10.583-7.66-20.057-21.67-20.057-13.9 0-21.57 9.474-21.57 20.057v1.3c0 10.583 7.66 20.157 21.57 20.157 14 0 21.67-9.575 21.67-20.157zM31.95 61.43C12.598 61.43 0 47.42 0 32.907v-1.814C0 16.277 12.598 2.57 31.95 2.57 51.402 2.57 64 16.277 64 31.093v1.814C64 47.42 51.402 61.43 31.95 61.43z"/>
                <path d="M38.702 21.62c1.915 1.2 2.42 3.73 1.2 5.543L30.54 41.676c-1.2 1.814-3.628 2.42-5.543 1.2-1.814-1.2-2.318-3.73-1.1-5.543L33.26 22.83c1.2-1.814 3.628-2.42 5.443-1.2z"/>
              </svg>
            )}
            {job.logo === "oracle" && (
              <svg viewBox="0 0 64 64" fill="currentColor" class="w-5 h-5">
                <path d="M20.2 52.2C8.93 52.2 0 43.056 0 32c0-11.27 9.143-20.2 20.2-20.2h23.6C55.07 11.8 64 20.944 64 32c0 11.27-9.143 20.2-20.2 20.2zm23.176-7.23c7.23 0 13.183-5.953 13.183-13.183s-5.953-13.183-13.183-13.183H20.837c-7.23 0-13.183 5.953-13.183 13.183S13.608 44.97 20.837 44.97z"/>
              </svg>
            )}
          </a>
          <div class="experience-row__main">
            <h3>{job.role}</h3>
            <p>{job.company}{job.team && <span> · {job.team}</span>}</p>
          </div>
          <time>{job.period}</time>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="home-section section-grid">
    <div class="section-intro">
      <p class="section-label">Projects</p>
      <h2>Personal builds</h2>
    </div>
    <div class="project-list">
      {projects.map((project) => (
        <article class="project-row">
          <div class="project-row__main">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">
                {project.name}
              </a>
            </h3>
            <p>{project.summary}</p>
          </div>
          <div class="project-row__meta">
            <div class="project-tags" aria-label={`${project.name} tags`}>
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <a href={project.url} target="_blank" rel="noopener" class="project-link">
              {project.cta}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="skills" class="home-section section-grid">
    <div class="section-intro">
      <p class="section-label">Skills</p>
      <h2>Tools and activity</h2>
    </div>
    <div class="skills-stack">
      <div class="skill-cloud" aria-label="Skills">
        {skillTags.map((skill) => (
          <span class="tag">{skill}</span>
        ))}
      </div>

      <div class="github-activity">
        <div class="github-activity__header">
          <h3>{githubContributionTitle}</h3>
          <a
            href={githubProfileYearUrl}
            target="_blank"
            rel="noopener"
            class="github-activity__profile"
          >
            View profile
          </a>
        </div>
        {githubContributions.length > 0 ? (
          <div class="github-activity__card">
            <div class="github-calendar" role="group" aria-label="GitHub contribution activity for kat3samsin">
              <div class="github-calendar__inner">
                <div class="github-calendar__months" aria-hidden="true">
                  {githubMonthPositions.map((month) => (
                    <span style={`grid-column: ${month.column};`}>{month.label}</span>
                  ))}
                </div>
                <div class="github-calendar__weekdays" aria-hidden="true">
                  <span style="grid-row: 2;">Mon</span>
                  <span style="grid-row: 4;">Wed</span>
                  <span style="grid-row: 6;">Fri</span>
                </div>
                <div class="github-calendar__grid">
                  {githubContributions.map((day) => (
                    <a
                      href={day.url}
                      target="_blank"
                      rel="noopener"
                      class={`github-day github-day--${day.level}`}
                      style={`grid-column: ${day.column}; grid-row: ${day.row};`}
                      title={day.label}
                      aria-label={day.label}
                    >
                      <span class="sr-only">{day.label}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
            <div class="github-activity__footer">
              <a href={githubContributionDocsUrl} target="_blank" rel="noopener" class="github-activity__learn">
                Learn how we count contributions
              </a>
              <div class="github-activity__legend" aria-hidden="true">
                <span>Less</span>
                <div class="github-activity__legend-cells">
                  {githubLegendLevels.map((level) => (
                    <span class={`github-legend-cell github-day--${level}`}></span>
                  ))}
                </div>
                <span>More</span>
              </div>
            </div>
          </div>
        ) : (
          <p class="github-activity__fallback">
            Contribution activity is available on GitHub.
          </p>
        )}
      </div>
    </div>
  </section>

  <section id="about" class="home-section section-grid">
    <div class="section-intro">
      <p class="section-label">About</p>
      <h2>Off the laptop</h2>
    </div>
    <p class="about-copy">
      Outside of work, life revolves around my family and my mini human, my two cats
      Charlie and Zoey, and a collection of hobbies that somehow keep growing. You'll
      usually find me adding another plant to the house, working through an ever-expanding
      reading list, experimenting with coffee, trying new recipes in the kitchen, logging
      miles on the road, lifting weights, or planning the next family adventure. I'm
      happiest when I'm learning something new, building something useful, or spending
      time with the people and pets I care about most.
    </p>
  </section>

  <section class="home-section home-duo" aria-label="Writing and reading">
    <div>
      <div class="section-heading-row">
        <div>
          <p class="section-label">Musings</p>
          <h2>Recent writing</h2>
        </div>
        <a href="/musings" class="section-link">All musings</a>
      </div>
      {posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post) => (
            <article class="post-item">
              <a href={`/musings/${post.slug}`}>
                <time>{post.formattedDate}</time>
                <h3>{post.title}</h3>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Posts coming soon.</p>
        </div>
      )}
    </div>

    <div>
      <div class="section-heading-row">
        <div>
          <p class="section-label">Library</p>
          <h2>Currently reading</h2>
        </div>
        <a href="/library" class="section-link">My library</a>
      </div>
      <div class="home-shelf">
        {currentlyReading.map((book) => (
          <a
            href="/library"
            class="home-book"
            aria-label={`${book.title} by ${book.author}`}
            style={`width: ${getThickness(book.pages)}px; height: ${getHeight(book.pages)}px; margin-right: ${book.gap}px; --tilt: ${book.tilt}deg;`}
          >
            <div class="home-book__3d">
              <div class="home-book__spine" style={`background: ${getSpineColor(book.color)}; color: ${getTextColor(muteColor(book.color))};`}>
                <span class="home-book__title">{book.title}</span>
                <div class="home-book__progress">
                  <div class="home-book__progress-bar" style={`width: ${book.progress}%`}></div>
                </div>
              </div>
              <img
                class="home-book__cover"
                src={`https://covers.openlibrary.org/b/isbn/${book.isbn}-L.jpg`}
                alt=""
                loading="lazy"
              />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
