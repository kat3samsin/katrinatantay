---
import Layout from '../layouts/Layout.astro';
import { getPosts } from '../lib/wordpress';

// Fetch posts from WordPress
const posts = await getPosts(10);
---

<Layout title="Musings - Katrina Tantay">
  <section>
    <h1 class="text-3xl font-semibold mb-4" aria-label="Musings">Musings</h1>
    <p class="text-[var(--color-text-secondary)] mb-12">
      Musings on software engineering, technology, and life.
    </p>

    {posts.length > 0 ? (
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="group">
            <a href={`/musings/${post.slug}`} class="block">
              <time class="text-sm text-[var(--color-text-secondary)]">
                {post.formattedDate}
              </time>
              <h2 class="text-xl font-medium mt-1 group-hover:text-[var(--color-accent)] transition-colors">
                {post.title}
              </h2>
              {post.excerpt && (
                <p class="text-[var(--color-text-secondary)] mt-2">
                  {post.excerpt}
                </p>
              )}
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-[var(--color-text-secondary)]">
          No posts yet.
        </p>
      </div>
    )}
  </section>

  <div class="mt-12">
    <a href="/" class="text-sm link-accent">← Back home</a>
  </div>
</Layout>
