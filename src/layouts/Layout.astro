---
import '../styles/global.css'

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Katrina Tantay | Applied AI Engineer",
  description = "Applied AI Engineer at WordPress, working on AI chat, image generation, MCP tools, provider/eval plumbing, UI polish, tests, accessibility, and production edge cases."
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Newsreader:opsz,wght@6..72,600;6..72,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      const themeDefaultVersion = 'white-default-2026-05-30-2';
      if (localStorage.getItem('theme-default-version') !== themeDefaultVersion) {
        localStorage.setItem('theme', 'default');
        localStorage.setItem('theme-default-version', themeDefaultVersion);
      }
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme && savedTheme !== 'default') {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    </script>
    <style>
      .theme-picker {
        position: relative;
      }
      .theme-menu {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 0.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 0.375rem;
        padding: 0.25rem;
        min-width: 140px;
        z-index: 50;
        box-shadow: 0 18px 42px rgba(31, 36, 33, 0.16);
      }
      .theme-menu button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 0.5rem 0.75rem;
        font-size: 0.75rem;
        color: var(--color-text-secondary);
        border-radius: 0.25rem;
        transition: all 0.15s;
      }
      .theme-menu button:hover {
        background: var(--color-border);
        color: var(--color-text-primary);
      }
      .theme-menu button.active {
        color: var(--color-accent);
      }
    </style>
  </head>
  <body class="min-h-screen">
    <div class="site-shell">
      <header class="site-header">
        <nav class="site-nav">
          <div class="site-nav__links">
            <a
              href="/#cv"
              class="site-nav__link"
            >
              CV
            </a>
            <a
              href="/#about"
              class="site-nav__link"
            >
              About
            </a>
            <a
              href="/library"
              class:list={[
                "site-nav__link",
                currentPath.startsWith("/library") && "is-active"
              ]}
            >
              Library
            </a>
            <a
              href="/musings"
              class:list={[
                "site-nav__link",
                currentPath.startsWith("/musings") && "is-active"
              ]}
            >
              Musings
            </a>
            <div class="theme-picker">
              <button
                id="theme-toggle"
                class="theme-toggle"
                aria-label="Change theme"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <circle cx="12" cy="12" r="4"/>
                  <line x1="21.17" y1="8" x2="12" y2="8"/>
                  <line x1="3.95" y1="6.06" x2="8.54" y2="14"/>
                  <line x1="10.88" y1="21.94" x2="15.46" y2="14"/>
                </svg>
              </button>
              <div id="theme-menu" class="theme-menu hidden">
                <button data-theme="default">White Light</button>
                <button data-theme="claude-code">Claude Code</button>
                <button data-theme="one-dark">One Dark Pro</button>
                <button data-theme="dracula">Dracula</button>
                <button data-theme="github-dark">GitHub Dark</button>
                <button data-theme="monokai">Monokai</button>
                <button data-theme="nord">Nord</button>
              </div>
            </div>
          </div>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer__inner">
          <span>&copy; {new Date().getFullYear()} Katrina Tantay</span>
          <div class="site-footer__links">
            <a href="https://github.com/kat3samsin" target="_blank" rel="noopener" class="site-footer__icon" aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.3c0 .32.22.69.83.57A12.01 12.01 0 0 0 24 12c0-6.63-5.37-12-12-12Z" />
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/katrinatantay/" target="_blank" rel="noopener" class="site-footer__icon" aria-label="LinkedIn" title="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.23 0Z" />
              </svg>
            </a>
            <a href="mailto:hi@katrinatantay.com" class="site-footer__icon" aria-label="Email" title="Email">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-.4 4.25-7.06 4.41a1 1 0 0 1-1.08 0L4.4 8.25V6.5L12 11.25l7.6-4.75v1.75Z" />
              </svg>
            </a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const toggle = document.getElementById('theme-toggle');
      const menu = document.getElementById('theme-menu');
      const buttons = menu?.querySelectorAll('button');

      function getCurrentTheme() {
        return document.documentElement.getAttribute('data-theme') || 'default';
      }

      function setTheme(theme: string) {
        if (theme === 'default') {
          document.documentElement.removeAttribute('data-theme');
        } else {
          document.documentElement.setAttribute('data-theme', theme);
        }
        localStorage.setItem('theme', theme);
        localStorage.setItem('theme-default-version', 'white-default-2026-05-30-2');
        updateActiveButton();
      }

      function updateActiveButton() {
        const current = getCurrentTheme();
        buttons?.forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-theme') === current);
        });
      }

      // Toggle menu visibility
      toggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        menu?.classList.toggle('hidden');
      });

      // Handle theme selection
      buttons?.forEach(btn => {
        btn.addEventListener('click', () => {
          const theme = btn.getAttribute('data-theme');
          if (theme) setTheme(theme);
          menu?.classList.add('hidden');
        });
      });

      // Close menu on outside click
      document.addEventListener('click', () => {
        menu?.classList.add('hidden');
      });

      // Initial state
      updateActiveButton();
    </script>
  </body>
</html>
