---
import '../styles/global.css'

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Katrina Tantay | Applied AI Engineer",
  description = "Applied AI Engineer at WordPress, working on AI chat, image generation, MCP tools, provider/eval plumbing, UI polish, tests, accessibility, and production edge cases."
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Newsreader:opsz,wght@6..72,600;6..72,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      const themeDefaultVersion = 'white-default-2026-05-30-2';
      if (localStorage.getItem('theme-default-version') !== themeDefaultVersion) {
        localStorage.setItem('theme', 'default');
        localStorage.setItem('theme-default-version', themeDefaultVersion);
      }
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme && savedTheme !== 'default') {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    </script>
    <style>
      .theme-picker {
        position: relative;
      }
      .theme-menu {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 0.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 0.375rem;
        padding: 0.25rem;
        min-width: 140px;
        z-index: 50;
        box-shadow: 0 18px 42px rgba(31, 36, 33, 0.16);
      }
      .theme-menu button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 0.5rem 0.75rem;
        font-size: 0.75rem;
        color: var(--color-text-secondary);
        border-radius: 0.25rem;
        transition: all 0.15s;
      }
      .theme-menu button:hover {
        background: var(--color-border);
        color: var(--color-text-primary);
      }
      .theme-menu button.active {
        color: var(--color-accent);
      }
    </style>
  </head>
  <body class="min-h-screen">
    <div class="site-shell">
      <header class="site-header">
        <nav class="site-nav">
          <div class="site-nav__links">
            <a
              href="/#cv"
              class="site-nav__link"
            >
              CV
            </a>
            <a
              href="/#about"
              class="site-nav__link"
            >
              About
            </a>
            <a
              href="/library"
              class:list={[
                "site-nav__link",
                currentPath.startsWith("/library") && "is-active"
              ]}
            >
              Library
            </a>
            <a
              href="/musings"
              class:list={[
                "site-nav__link",
                currentPath.startsWith("/musings") && "is-active"
              ]}
            >
              Musings
            </a>
            <div class="theme-picker">
              <button
                id="theme-toggle"
                class="theme-toggle"
                aria-label="Change theme"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <circle cx="12" cy="12" r="4"/>
                  <line x1="21.17" y1="8" x2="12" y2="8"/>
                  <line x1="3.95" y1="6.06" x2="8.54" y2="14"/>
                  <line x1="10.88" y1="21.94" x2="15.46" y2="14"/>
                </svg>
              </button>
              <div id="theme-menu" class="theme-menu hidden">
                <button data-theme="default">White Light</button>
                <button data-theme="claude-code">Claude Code</button>
                <button data-theme="one-dark">One Dark Pro</button>
                <button data-theme="dracula">Dracula</button>
                <button data-theme="github-dark">GitHub Dark</button>
                <button data-theme="monokai">Monokai</button>
                <button data-theme="nord">Nord</button>
              </div>
            </div>
          </div>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer__inner">
          <span>&copy; {new Date().getFullYear()} Katrina Tantay</span>
          <div class="site-footer__links">
            <a href="https://github.com/kat3samsin" target="_blank" rel="noopener">
              GitHub
            </a>
            <a href="https://www.linkedin.com/in/katrinatantay/" target="_blank" rel="noopener">
              LinkedIn
            </a>
            <a href="mailto:hi@katrinatantay.com">
              Email
            </a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const toggle = document.getElementById('theme-toggle');
      const menu = document.getElementById('theme-menu');
      const buttons = menu?.querySelectorAll('button');

      function getCurrentTheme() {
        return document.documentElement.getAttribute('data-theme') || 'default';
      }

      function setTheme(theme: string) {
        if (theme === 'default') {
          document.documentElement.removeAttribute('data-theme');
        } else {
          document.documentElement.setAttribute('data-theme', theme);
        }
        localStorage.setItem('theme', theme);
        localStorage.setItem('theme-default-version', 'white-default-2026-05-30-2');
        updateActiveButton();
      }

      function updateActiveButton() {
        const current = getCurrentTheme();
        buttons?.forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('data-theme') === current);
        });
      }

      // Toggle menu visibility
      toggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        menu?.classList.toggle('hidden');
      });

      // Handle theme selection
      buttons?.forEach(btn => {
        btn.addEventListener('click', () => {
          const theme = btn.getAttribute('data-theme');
          if (theme) setTheme(theme);
          menu?.classList.add('hidden');
        });
      });

      // Close menu on outside click
      document.addEventListener('click', () => {
        menu?.classList.add('hidden');
      });

      // Initial state
      updateActiveButton();
    </script>
  </body>
</html>
